<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login</title>
    <style>
        body {
            font-family: sans-serif;
            background: #f4f4f4;
        }

        .container {
            max-width: 400px;
            margin: 100px auto;
            padding: 2em;
            background: white;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .form-group {
            margin-bottom: 1em;
        }

        label {
            display: block;
            margin-bottom: 0.5em;
        }

        input {
            width: 100%;
            padding: 0.5em;
        }

        button {
            padding: 0.7em 1.5em;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .error {
            color: red;
            margin-top: 1em;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Login</h2>
        <form id="loginForm">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required />
            </div>
            <input type="hidden" id="redirect" name="redirect" value="{{ .Redirect }}">
            <button type="submit">Login</button>
            <div id="error" class="error" style="display:none;"></div>
        </form>
    </div>
    <script>
        document.getElementById('loginForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;
            const redirect = document.getElementById('redirect').value || '/dashboard';
            const credentials = btoa(user + ':' + pass);

            // Prova ad accedere a una risorsa protetta con Basic Auth
            const response = await fetch(redirect, {
                method: 'GET',
                headers: {
                    'Authorization': 'Basic ' + credentials
                }
            });

            if (response.status === 200) {
                // Salva le credenziali in sessionStorage per usarle nelle richieste successive (opzionale)
                sessionStorage.setItem('basicAuth', credentials);
                window.location.href = redirect;
            } else if (response.status === 401) {
                document.getElementById('error').innerText = "Credenziali non valide";
                document.getElementById('error').style.display = "block";
            } else {
                document.getElementById('error').innerText = "Errore: " + response.status;
                document.getElementById('error').style.display = "block";
            }
        });
    </script>
</body>

</html>